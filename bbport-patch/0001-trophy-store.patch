diff --git a/src/runtime_trophy.c b/src/runtime_trophy.c
new file mode 100644
index 0000000..eaaf743
--- /dev/null
+++ b/src/runtime_trophy.c
@@ -0,0 +1,70 @@
+/* Local trophy store (format v1, one event per line, no deduplication):
+ *   {"v":1,"title_id":"CUSA03173","trophy_id":12,"unlocked_at":"2026-10-10T06:30:00Z"}
+ * The file is opened in append mode for every event and each line is written with a single
+ * fwrite under a process-wide mutex, so concurrent unlocks never interleave. Failures are
+ * reported through the return value only: the caller logs them and the game keeps running. */
+#if !defined(_WIN32) && !defined(_POSIX_C_SOURCE)
+#define _POSIX_C_SOURCE 200809L /* gmtime_r */
+#endif
+#include "runtime_trophy.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static pthread_mutex_t store_lock=PTHREAD_MUTEX_INITIALIZER;
+static char configured_title[17];
+
+/* [A-Z0-9]{4,16}: the only characters that reach the JSON line unescaped. */
+static int valid_title(const char *title_id) {
+    if (!title_id) return 0;
+    size_t n=strlen(title_id);
+    if (n<4 || n>16) return 0;
+    for (size_t i=0;i<n;++i) {
+        char c=title_id[i];
+        if (!((c>='A' && c<='Z') || (c>='0' && c<='9'))) return 0;
+    }
+    return 1;
+}
+
+static int utc_now(char out[21]) {
+    time_t now=time(NULL);
+    struct tm tm;
+    if (now==(time_t)-1) return -1;
+#ifdef _WIN32
+    if (gmtime_s(&tm,&now)) return -1;
+#else
+    if (!gmtime_r(&now,&tm)) return -1;
+#endif
+    return strftime(out,21,"%Y-%m-%dT%H:%M:%SZ",&tm)==20 ? 0 : -1;
+}
+
+int trophy_store_append(const char *user_dir, const char *title_id, int32_t trophy_id) {
+    if (!user_dir || !*user_dir || !valid_title(title_id) || trophy_id<0 || trophy_id>255) return -1;
+    char path[4096], stamp[21], line[128];
+    int n=snprintf(path,sizeof(path),"%s/" TROPHY_STORE_FILE,user_dir);
+    if (n<0 || (size_t)n>=sizeof(path) || utc_now(stamp)) return -1;
+    n=snprintf(line,sizeof(line),"{\"v\":1,\"title_id\":\"%s\",\"trophy_id\":%d,\"unlocked_at\":\"%s\"}\n",
+               title_id,(int)trophy_id,stamp);
+    if (n<0 || (size_t)n>=sizeof(line)) return -1;
+    if (pthread_mutex_lock(&store_lock)) return -1;
+    int result=-1;
+    FILE *f=fopen(path,"ab");
+    if (f) {
+        if (fwrite(line,1,(size_t)n,f)==(size_t)n && !fflush(f)) result=0;
+        if (fclose(f)) result=-1;
+    }
+    pthread_mutex_unlock(&store_lock);
+    return result;
+}
+
+void trophy_store_configure(const char *title_id) {
+    if (!valid_title(title_id)) return;
+    pthread_mutex_lock(&store_lock);
+    memcpy(configured_title,title_id,strlen(title_id)+1);
+    pthread_mutex_unlock(&store_lock);
+}
+
+const char *trophy_store_title_id(void) {
+    return configured_title[0] ? configured_title : TROPHY_STORE_DEFAULT_TITLE;
+}
diff --git a/src/runtime_trophy.h b/src/runtime_trophy.h
new file mode 100644
index 0000000..570729e
--- /dev/null
+++ b/src/runtime_trophy.h
@@ -0,0 +1,18 @@
+/* Local trophy store: every unlock is appended as one JSON line to <user>/trophies.jsonl.
+ * Opt-in companion tools may read that file; the runtime itself never touches the network. */
+#ifndef BB_RUNTIME_TROPHY_H
+#define BB_RUNTIME_TROPHY_H
+#include <stdint.h>
+
+/* Appends one unlock event as a JSON line to <user_dir>/trophies.jsonl.
+   Returns 0 on success, -1 on failure. Never aborts. Thread-safe. */
+int trophy_store_append(const char *user_dir, const char *title_id, int32_t trophy_id);
+
+/* Remembers the TITLE_ID read from param.sfo; invalid or missing values keep the fallback. */
+void trophy_store_configure(const char *title_id);
+/* TITLE_ID used for unlock events: the configured one, or TROPHY_STORE_DEFAULT_TITLE. */
+const char *trophy_store_title_id(void);
+
+#define TROPHY_STORE_DEFAULT_TITLE "CUSA03173"
+#define TROPHY_STORE_FILE "trophies.jsonl"
+#endif
diff --git a/tests/test_trophy.c b/tests/test_trophy.c
new file mode 100644
index 0000000..e69fc17
--- /dev/null
+++ b/tests/test_trophy.c
@@ -0,0 +1,115 @@
+/* Standalone test for the local trophy store (src/runtime_trophy.c only).
+ * Usage: trophy-test [temp_dir]   (default: out/trophy_test_tmp) */
+#include "runtime_trophy.h"
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <direct.h>
+#define make_dir(p) _mkdir(p)
+#else
+#include <sys/stat.h>
+#define make_dir(p) mkdir(p,0755)
+#endif
+
+#define THREADS 8
+#define PER_THREAD 50
+static char dir[1024], file[1100];
+
+/* Checks one line against the exact v1 layout; returns the trophy id or -1. */
+static int parse_line(const char *line, const char *title) {
+    char got[32], stamp[32], tail[8];
+    int id=-1;
+    if (sscanf(line,"{\"v\":1,\"title_id\":\"%31[A-Z0-9]\",\"trophy_id\":%d,\"unlocked_at\":\"%31[0-9TZ:-]\"%7s",
+               got,&id,stamp,tail)!=4) return -1;
+    if (strcmp(got,title) || strcmp(tail,"}") || strlen(stamp)!=20 || stamp[10]!='T' || stamp[19]!='Z') return -1;
+    return id;
+}
+
+/* Reads the file, validates every line and returns the count; ids[] collects the trophy ids. */
+static int check_file(const char *title, int *ids, int max) {
+    FILE *f=fopen(file,"rb");
+    assert(f);
+    char line[256];
+    int count=0;
+    while (fgets(line,sizeof(line),f)) {
+        size_t n=strlen(line);
+        assert(n>1 && line[n-1]=='\n');
+        line[n-1]=0;
+        int id=parse_line(line,title);
+        assert(id>=0 && id<=255);
+        assert(count<max);
+        ids[count++]=id;
+    }
+    fclose(f);
+    return count;
+}
+
+static void *writer(void *arg) {
+    int base=(int)(size_t)arg;
+    for (int i=0;i<PER_THREAD;++i) assert(trophy_store_append(dir,"CUSA03173",(base*PER_THREAD+i)%256)==0);
+    return NULL;
+}
+
+int main(int argc,char **argv) {
+    snprintf(dir,sizeof(dir),"%s",argc>1 ? argv[1] : "out/trophy_test_tmp");
+    snprintf(file,sizeof(file),"%s/" TROPHY_STORE_FILE,dir);
+    if (make_dir(dir) && errno!=EEXIST) { perror(dir); return 1; }
+    remove(file);
+
+    /* Three events, three lines, in order. */
+    int ids[THREADS*PER_THREAD];
+    assert(trophy_store_append(dir,"CUSA03173",0)==0);
+    assert(trophy_store_append(dir,"CUSA03173",12)==0);
+    assert(trophy_store_append(dir,"CUSA03173",255)==0);
+    assert(check_file("CUSA03173",ids,3)==3 && ids[0]==0 && ids[1]==12 && ids[2]==255);
+    puts("PASS: three events appended");
+
+    /* Invalid input writes nothing. */
+    assert(trophy_store_append(dir,"CUSA\"03173",1)==-1);
+    assert(trophy_store_append(dir,"",1)==-1);
+    assert(trophy_store_append(dir,NULL,1)==-1);
+    assert(trophy_store_append(dir,"cusa03173",1)==-1);
+    assert(trophy_store_append(dir,"ABC",1)==-1);
+    assert(trophy_store_append(dir,"ABCDEFGHIJKLMNOPQ",1)==-1);
+    assert(trophy_store_append(dir,"CUSA03173",-1)==-1);
+    assert(trophy_store_append(dir,"CUSA03173",256)==-1);
+    assert(trophy_store_append(NULL,"CUSA03173",1)==-1);
+    assert(trophy_store_append("",  "CUSA03173",1)==-1);
+    assert(check_file("CUSA03173",ids,3)==3);
+    puts("PASS: invalid title_id / trophy_id rejected");
+
+    /* A missing directory fails without aborting. */
+    char missing[1100];
+    snprintf(missing,sizeof(missing),"%s/does-not-exist",dir);
+    assert(trophy_store_append(missing,"CUSA03173",1)==-1);
+    puts("PASS: unwritable directory reported");
+
+    /* Title configuration: fallback, valid override, invalid values ignored. */
+    assert(!strcmp(trophy_store_title_id(),TROPHY_STORE_DEFAULT_TITLE));
+    trophy_store_configure("CUSA\"X");
+    trophy_store_configure(NULL);
+    assert(!strcmp(trophy_store_title_id(),TROPHY_STORE_DEFAULT_TITLE));
+    trophy_store_configure("CUSA00900");
+    assert(!strcmp(trophy_store_title_id(),"CUSA00900"));
+    puts("PASS: title configuration");
+
+    /* Concurrent writers: no lost or interleaved lines. */
+    remove(file);
+    pthread_t threads[THREADS];
+    for (int i=0;i<THREADS;++i) assert(!pthread_create(&threads[i],NULL,writer,(void *)(size_t)i));
+    for (int i=0;i<THREADS;++i) assert(!pthread_join(threads[i],NULL));
+    int count=check_file("CUSA03173",ids,THREADS*PER_THREAD);
+    assert(count==THREADS*PER_THREAD);
+    int seen[256]={0};
+    for (int i=0;i<count;++i) ++seen[ids[i]];
+    for (int i=0;i<THREADS*PER_THREAD;++i) assert(seen[i%256]>0);
+    printf("PASS: %d concurrent events, %d valid lines\n",THREADS*PER_THREAD,count);
+
+    remove(file);
+    puts("PASS: trophy store");
+    return 0;
+}
